<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-12 mb-3">
            <div class="card shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                        <h5 class="card-title mb-1">@item.Nome @item.Cognome</h5>
                        <span class="text-muted">@item.Citta</span> - 
                        <span>@item.Email</span>
                    </div>
                    <div>
                        @if(@item.Disponibilita == "1")
                        {
                            <span class="badge bg-success">Dispobibile Subito</span>    
                        }
                        else if(@item.Disponibilita == "2")
                        {
                            <span class="badge bg-warning">tra una settimana</span> 
                        }
                        else if(@item.Disponibilita == "3")
                        {
                            <span class="badge bg-warning">tra due settimane</span> 
                        }
                        else if(@item.Disponibilita == "4")
                        {
                            <span class="badge bg-danger">tra un mese</span> 
                        }
                        else
                        {
                            <span class="badge bg-danger">Non Disponibile</span> 
                        }

                    </div>
                </div>
            </div>
        </div>
    }
</div>